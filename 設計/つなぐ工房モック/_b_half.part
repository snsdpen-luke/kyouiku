<div style="width:1366px;height:768px;overflow:hidden">

<header class="face">
  <div class="brand">
    <div class="mark">LOG</div>
    <div>
      <h1>つなぐ工房</h1>
      <div class="sub">LOGIC WORKSHOP ／ スイッチ・AND・OR・NOT から 加算器 まで</div>
    </div>
  </div>
  <div class="leds">
    <div class="led on"><i></i><span>POWER</span></div>
    <div class="led on"><i></i><span>RUN</span></div>
  </div>
  <div class="ctl">
    <span class="btn stop">■ 編集にもどる</span>
    <span class="btn ghost">はじめから</span>
  </div>
</header>

<div class="statusbar">
  <div class="st live"><span class="k">MODE</span><span class="v">運転</span></div>
  <div class="st"><span class="k">LESSON</span><span class="v">7 / 9</span></div>
  <div class="st"><span class="k">INPUT</span><span class="v">A=1　B=1</span></div>
  <div class="st"><span class="k">OUTPUT</span><span class="v">C=1　S=0</span></div>
  <div class="st"><span class="k">TRIED</span><span class="v">4 / 4 とおり</span></div>
  <div class="st ver"><span class="k">VER</span><span class="v">2026-09-14a</span></div>
</div>

<nav class="tabs">
  <div class="tabrow">
    <div class="grplab">キホン</div>
    <div class="tab done">1 スイッチ</div>
    <div class="tab done">2 直列</div>
    <div class="tab done">3 並列</div>
    <div class="tab done">4 NOT</div>
    <div class="tab done">5 真理値表</div>
  </div>
  <div class="tabrow">
    <div class="grplab">カダイ</div>
    <div class="tab done">6 XOR</div>
    <div class="tab now">7 半加算器</div>
    <div class="tab">8 全加算器</div>
    <div class="tab">9 4ビット</div>
  </div>
</nav>

<div class="cols">
  <main>
    <div class="panel goal">
      <h2>課題7　二つの出口をもつ回路</h2>
      <p>課題6でつくった <b>XOR</b> を、そのまま置きなさい。となりに <b>AND</b> を置き、
         同じ A と B をつなぎなさい。出口は二つ、<b>S</b> と <b>C</b> です。</p>
      <p class="hint">４とおり全部ためしてから、真理値表の右はしを見なさい。</p>
    </div>

    <div class="panel board live2">
      <div class="secthead">
        <span class="sectk">STEP 2</span>
        <span class="sectt">動かして確かめる</span>
        <span class="sectstate">運転モード<br>回路は編集できません</span>
      </div>
      <div class="wirewrap">
        <svg viewBox="0 0 700 300" width="100%" height="300" role="img" aria-label="半加算器の配線盤">
          <g stroke="#15a34a" stroke-width="12" stroke-linecap="round" opacity="0.2" fill="none">
            <path d="M78,90 H150 V212"/><path d="M150,112 H300"/><path d="M150,212 H300"/>
            <path d="M78,248 H180 V148"/><path d="M180,148 H300"/><path d="M180,248 H300"/>
            <path d="M358,230 H568"/>
          </g>
          <g stroke="#15a34a" stroke-width="5" stroke-linecap="round" fill="none">
            <path d="M78,90 H150 V212"/><path d="M150,112 H300"/>
            <path d="M78,248 H180 V148"/><path d="M180,148 H300"/><path d="M180,248 H300"/>
            <path d="M358,230 H568"/>
            <path d="M150,212 H172 M188,212 H300"/>
            <path d="M172,212 A8,8 0 0 1 188,212" fill="none"/>
          </g>
          <g stroke="#9a917d" stroke-width="4" stroke-linecap="round" fill="none">
            <path d="M360,130 H568"/>
          </g>

          <g fill="#15a34a">
            <circle cx="150" cy="112" r="5"/><circle cx="180" cy="148" r="5"/>
            <circle cx="150" cy="212" r="5"/><circle cx="180" cy="248" r="5"/>
          </g>

          <g>
            <circle cx="72" cy="90" r="8" fill="#fff6e3" stroke="#e0a93a" stroke-width="3"/>
            <text x="72" y="68" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="13" font-weight="700" fill="#0f7a37">A ＝ 1</text>
            <circle cx="72" cy="248" r="8" fill="#fff6e3" stroke="#e0a93a" stroke-width="3"/>
            <text x="72" y="282" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="13" font-weight="700" fill="#0f7a37">B ＝ 1</text>
          </g>

          <g>
            <path d="M300,102 Q318,130 300,158 Q346,158 360,130 Q346,102 300,102" fill="#ffffff" stroke="#3d3830" stroke-width="4" stroke-linejoin="round"/>
            <path d="M288,102 Q306,130 288,158" fill="none" stroke="#3d3830" stroke-width="4"/>
            <text x="326" y="135" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="11" font-weight="700" fill="#6d6555">XOR</text>
          </g>
          <g>
            <path d="M300,202 L330,202 A28,28 0 0 1 330,258 L300,258 Z" fill="#ffffff" stroke="#15a34a" stroke-width="4" stroke-linejoin="round"/>
            <text x="322" y="235" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="11" font-weight="700" fill="#0f7a37">AND</text>
          </g>

          <g>
            <circle cx="590" cy="130" r="22" fill="#ffffff" stroke="#3d3830" stroke-width="4"/>
            <line x1="575" y1="115" x2="605" y2="145" stroke="#3d3830" stroke-width="3"/>
            <line x1="575" y1="145" x2="605" y2="115" stroke="#3d3830" stroke-width="3"/>
            <text x="590" y="94" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="13" font-weight="700" fill="#6d6555">S  和 ＝ 0</text>
          </g>
          <g>
            <circle cx="590" cy="230" r="30" fill="#f59e0b" opacity="0.22"/>
            <circle cx="590" cy="230" r="22" fill="#ffe08a" stroke="#b87406" stroke-width="4"/>
            <line x1="575" y1="215" x2="605" y2="245" stroke="#b87406" stroke-width="3"/>
            <line x1="575" y1="245" x2="605" y2="215" stroke="#b87406" stroke-width="3"/>
            <text x="590" y="282" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="13" font-weight="700" fill="#7a4f00">C  繰上 ＝ 1</text>
          </g>
        </svg>
      </div>
    </div>
  </main>

  <aside>
    <div class="panel board live2">
      <div class="blab">ソウサバン</div>
      <div class="devrow" style="margin-bottom:9px">
        <div class="xbtn sw on"><span class="swknob"></span>A<span class="tag">スイッチ</span></div>
        <div class="xbtn sw on"><span class="swknob"></span>B<span class="tag">スイッチ</span></div>
      </div>
      <div class="ylamp" style="margin-bottom:7px">S　和<span class="tag">きえている</span></div>
      <div class="ylamp on">C　繰上<span class="tag">ついている</span></div>
    </div>

    <div class="panel">
      <div class="blab">シンリチヒョウ　＝　ためした記録</div>
      <table class="tt">
        <tr><th>A</th><th>B</th><th class="sep">C</th><th>S</th><th class="sep new">10 シンスウ</th></tr>
        <tr><td>0</td><td>0</td><td class="sep">0</td><td>0</td><td class="sep new">0 ＋ 0 ＝ 0</td></tr>
        <tr><td>0</td><td>1</td><td class="sep">0</td><td>1</td><td class="sep new">0 ＋ 1 ＝ 1</td></tr>
        <tr><td>1</td><td>0</td><td class="sep">0</td><td>1</td><td class="sep new">1 ＋ 0 ＝ 1</td></tr>
        <tr class="nowrow"><td>1</td><td>1</td><td class="sep">1</td><td>0</td><td class="sep new">1 ＋ 1 ＝ 2</td></tr>
      </table>
      <div class="note">右はしの列は、この課題ではじめて出てきます。<br>
        C と S を左から並べて読むと、２けたの２進数になっています。</div>
    </div>

    <div class="btnrow">
      <span class="btn">たしかめる</span>
      <span class="btn ghost">ヒント</span>
    </div>
  </aside>
</div>

</div>
</x-dc>
</body>
</html>
